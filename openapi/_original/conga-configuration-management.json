                "schema": {
                  "$ref": "#/components/schemas/ConfigurationListAPIResponse"
                },
                "example": {
                  "Success": true,
                  "Data": [
                    {
                      "Category": "examplecategory",
                      "Name": "example1",
                      "Value": "examplevalue1"
